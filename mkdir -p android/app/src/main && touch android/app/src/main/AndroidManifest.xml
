<!-- android/app/src/main/AndroidManifest.xml : <manifest> ট্যাগের ভেতরে যোগ করো -->
<uses-permission android:name="android.permission.INTERNET"/>
<uses-permission android:name="android.permission.RECORD_AUDIO"/>
<uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>

<!-- Android 11+ এ ইনস্টল করা টিটিএস ইঞ্জিন (Google TTS, Multi-TTS ইত্যাদি) দেখার জন্য আবশ্যক -->
<queries>
    <intent>
        <action android:name="android.intent.action.TTS_SERVICE"/>
    </intent>
</queries>

<!-- android/app/build.gradle : defaultConfig এ minSdkVersion 21 বা তার বেশি রাখো -->